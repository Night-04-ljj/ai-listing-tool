# 复制为 .env 后填入 key： copy .env.example .env
# ⚠️ .env 不要提交到 GitHub

# DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4

# 备选：通义兼容模式
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 生成 → 校验 → 定点修复，最多几轮
MAX_REPAIR_ROUNDS=2
# 两轮还没改好时，是否用确定性规则兜底裁剪（保证一定有一条能交付的结果）
AUTO_FIX_FALLBACK=true

# 大模型响应缓存：同一个 Prompt 只真正调用一次，之后读本地缓存
# ⭐ 线下现场演示时，在家跑一遍，现场断网也能把完整流程演完
CACHE_LLM_RESPONSES=true
